# Application
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
SENTINEL_API_URL=http://127.0.0.1:8000/api/v1

# Physical Camera & YOLO Detection
DEFAULT_CAMERA_INDEX=0
MAX_CAMERA_PROBE_INDEX=5
YOLO_MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.50
FRAME_PROCESS_INTERVAL=0.15
INCIDENT_COOLDOWN_SECONDS=30

# PPE Policy
REQUIRE_HELMET=true
REQUIRE_VEST=true

# Firebase Cloud Firestore (keep actual JSON outside repo)
FIREBASE_CREDENTIALS_PATH=secrets/firebase-service-account.json
FIRESTORE_COLLECTION=safety_incidents

# Twilio Notifications
TWILIO_MOCK_MODE=true
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000
TWILIO_TO_NUMBER=+10000000000
TWILIO_ALERT_COOLDOWN_SECONDS=120
TWILIO_MIN_CONFIDENCE=0.55
